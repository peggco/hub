---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found — Pegg Skill Hub"
  description="The page you were looking for does not exist."
>
  <div class="container not-found">
    <div class="empty">
      <div class="empty-mark">∞</div>
      <h1>Page not found</h1>
      <p>
        This page does not exist. Head back to the hub to browse every skill in
        the directory.
      </p>
      <a class="btn btn-primary" href="/">Browse skills</a>
    </div>
  </div>
</Layout>
